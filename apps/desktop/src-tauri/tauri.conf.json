{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agentgrid",
  "version": "0.1.0",
  "identifier": "com.agentgrid.app",
  "build": {
    "beforeDevCommand": "node ./scripts/dev-stack.mjs",
    "devUrl": "http://127.0.0.1:5318",
    "beforeBuildCommand": "pnpm --dir ../.. --filter @agentgrid/web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "agentgrid",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../scripts/ensure-server.mjs"
    ]
  }
}
